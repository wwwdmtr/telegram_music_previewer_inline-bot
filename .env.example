# Скопируйте в .env и подставьте свои значения:  cp .env.example .env
# ВАЖНО: .env в git не коммитится (см. .gitignore).

# ---- Telegram ---------------------------------------------------------------
# Токен от @BotFather. Обязательно включите инлайн-режим:
#   /setinline  ->  выберите бота  ->  placeholder, напр. "название трека"
BOT_TOKEN=123456789:AAA-BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB

# ID через запятую — кому доступна команда /stats. Можно оставить пустым.
ADMIN_IDS=

# ---- Провайдеры -------------------------------------------------------------
# Порядок важен: первый ответивший побеждает, остальные — фолбэк.
PROVIDERS=deezer,itunes
# Бюджет на один запрос к апстриму.
UPSTREAM_TIMEOUT=2.0
# Потолок на весь поиск, включая фолбэк на второго провайдера. Без него худший
# случай — (ожидание лимитера + HTTP) на каждого провайдера, то есть ~8 сек,
# что пользователь видит как "бот повис".
SEARCH_TIMEOUT=4.0

# ---- Кэш --------------------------------------------------------------------
# memory — одна реплика бота; redis — если реплик несколько
CACHE_BACKEND=memory
REDIS_URL=redis://redis:6379/0
# 5 минут "свежести" — то, что отдаём сразу
CACHE_FRESH_TTL=300
# ещё 25 минут запись живёт как аварийный фолбэк, если все провайдеры лежат
CACHE_STALE_TTL=1800
CACHE_MAX_ENTRIES=5000

# ---- Поведение инлайна ------------------------------------------------------
PAGE_SIZE=20
MIN_QUERY_LENGTH=2
# Сколько Telegram сам кэширует наш ответ на edge — самый дешёвый слой кэша
INLINE_CACHE_TIME=300
ERROR_CACHE_TIME=5

# ---- Вид отправляемого сообщения --------------------------------------------
# Подпись под аудио:
#   full  — название, исполнитель, альбом, полная длительность, "превью 30 сек"
#   short — только название и исполнитель
#   none  — без подписи: плеер и так показывает название и исполнителя
CAPTION_STYLE=full
# Кнопка-ссылка на источник ("Открыть в Deezer") под отправленным треком
SHOW_SOURCE_BUTTON=true

# ---- Антифлуд на пользователя -----------------------------------------------
# Инлайн-запросы летят на каждое нажатие клавиши, поэтому лимит широкий:
# burst покрывает одну набранную фразу, rate — продолжение набора.
# Превышение просто отбрасывается: одно нажатие без результата незаметнее,
# чем строка с ошибкой.
THROTTLE_INLINE_RATE=2.0
THROTTLE_INLINE_BURST=10
# Сообщения в личке — осознанное действие, лимит намного ниже.
# Здесь о превышении сообщаем, но один раз, а не на каждое сообщение.
THROTTLE_MESSAGE_RATE=0.5
THROTTLE_MESSAGE_BURST=5
# Ограничение на число запомненных пользователей (защита от роста памяти)
THROTTLE_MAX_USERS=10000

# ---- Дебаунс инлайн-запросов ------------------------------------------------
# Telegram присылает запрос на каждое нажатие клавиши. Бот ждёт это время и,
# если пришло новое нажатие, старый запрос не отвечает — до Deezer доходит
# только последний префикс. 0 отключает.
# Склеивает набор быстрее чем 1/DELAY запросов в секунду: 0.25 -> быстрее 4/с.
# Уже закэшированные ответы ожидание пропускают, пагинация тоже.
DEBOUNCE_DELAY=0.25

LOG_LEVEL=INFO
